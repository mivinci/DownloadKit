{
  "name": "moo",
  "version": "1.0.0",
  "description": "An AI agent, written in C.",
  "license": "MIT",
  "author": "mivinci",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mivinci/moo.git"
  },
  "bugs": {
    "url": "https://github.com/mivinci/moo/issues"
  },
  "homepage": "https://le0.me/moo",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build": "cmake -B build -DMOO_BUILD_APPS=ON -DX_BUILD_EXAMPLES=ON -DX_DEBUG_LEVEL=1 && cmake --build build",
    "build-openssl": "cmake -B build-openssl -DMOO_BUILD_APPS=ON -DX_BUILD_EXAMPLES=ON -DX_TLS_BACKEND=openssl && cmake --build build-openssl",
    "build-mbedtls": "cmake -B build-mbedtls -DMOO_BUILD_APPS=ON -DX_BUILD_EXAMPLES=ON -DX_TLS_BACKEND=mbedtls && cmake --build build-mbedtls",
    "test": "ctest --test-dir build --output-on-failure",
    "bench": "ctest --test-dir build -L bench --output-on-failure",
    "build-docs": "mdbook build docs",
    "serve-docs": "mdbook serve docs --open",
    "clean": "rm -rf build build-openssl build-mbedtls book"
  }
}