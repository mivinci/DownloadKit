{
  "name": "xkit",
  "version": "1.0.0",
  "description": "A collection of low-level C building blocks for event-driven, asynchronous programming.",
  "license": "MIT",
  "author": "Leo X.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mivinci/xkit.git"
  },
  "bugs": {
    "url": "https://github.com/mivinci/xkit/issues"
  },
  "homepage": "https://le0.me/xKit",
  "keywords": [
    "c",
    "event-loop",
    "async",
    "http",
    "http2",
    "websocket",
    "p2p",
    "tls",
    "networking"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build": "cmake -B build -DXK_ENABLE_DEBUG=ON -DXK_BUILD_EXAMPLES=ON && cmake --build build --parallel",
    "build-openssl": "cmake -B build-openssl -DXK_ENABLE_DEBUG=ON -DXK_BUILD_EXAMPLES=ON -DXK_TLS_BACKEND=openssl && cmake --build build-openssl --parallel",
    "build-mbedtls": "cmake -B build-mbedtls -DXK_ENABLE_DEBUG=ON -DXK_BUILD_EXAMPLES=ON -DXK_TLS_BACKEND=mbedtls && cmake --build build-mbedtls --parallel"
  }
}