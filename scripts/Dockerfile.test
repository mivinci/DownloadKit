ARG BASE_IMAGE=gcc:14
FROM ${BASE_IMAGE}

ARG APT_MIRROR=

# Optionally swap APT mirror for faster downloads in China
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null \
      || sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list 2>/dev/null \
      || true; \
    fi

RUN apt-get update -qq && \
    apt-get install -y -qq \
      cmake pkg-config git \
      libssl-dev libcurl4-openssl-dev libmbedtls-dev libunwind-dev \
      > /dev/null 2>&1 && \
    rm -rf /var/lib/apt/lists/*

# Pre-fetch FetchContent dependencies during image build so containers
# never need to download them at runtime.  All FetchContent deps are
# identical regardless of TLS backend, so a single cmake configure suffices.
ARG TLS_BACKEND=openssl
COPY cmake /tmp/xkit-prefetch/cmake
COPY CMakeLists.txt /tmp/xkit-prefetch/
COPY modules /tmp/xkit-prefetch/modules
COPY bench /tmp/xkit-prefetch/bench
RUN cd /tmp/xkit-prefetch && \
    cmake -S . -B /tmp/xkit-build \
      -DCMAKE_BUILD_TYPE=Debug \
      -DXK_TLS_BACKEND=openssl \
      -DBUILD_TESTING=ON \
      -DFETCHCONTENT_BASE_DIR=/fetchcontent-cache && \
    rm -rf /tmp/xkit-prefetch /tmp/xkit-build

WORKDIR /work
